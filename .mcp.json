{
  "mcpServers": {
    "search-docs": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "-v", "${PWD}:/workspace:ro",
        "-v", "${PWD}/.search-docs:/workspace/.search-docs",
        "search-docs-mcp:dev"
      ],
      "env": {}
    },
    "search-docs-local": {
      "type": "stdio",
      "command": "node",
      "args": [
        "packages/mcp-server/dist/server.js",
        "--project-dir",
        "."
      ],
      "env": {}
    }
  }
}